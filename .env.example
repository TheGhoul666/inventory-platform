# ============================================================
# ENVIRONMENT CONFIGURATION — Supabase Edition
# Copy to .env and fill in values from your Supabase project.
# Dashboard → Settings → API
# ============================================================

# --- Application ---
APP_ENV=development
APP_NAME="Bus Inventory Platform"
APP_VERSION=1.0.0
APP_SECRET_KEY=CHANGE_ME_32_CHAR_SECRET

# --- Supabase ---
# Dashboard → Settings → API
SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
SUPABASE_SERVICE_ROLE_KEY=YOUR_SERVICE_ROLE_SECRET_KEY

# Dashboard → Settings → Database → Connection string (URI mode)
# Use the "Transaction" pooler string (port 6543) for serverless/edge
# Use the "Session" pooler string (port 5432) for persistent apps
DATABASE_URL=postgresql+asyncpg://postgres.YOUR_PROJECT_REF:YOUR_DB_PASSWORD@aws-0-us-east-1.pooler.supabase.com:6543/postgres
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# JWT secret — Dashboard → Settings → API → JWT Secret
# The backend uses this to verify Supabase-issued JWTs without a network call.
SUPABASE_JWT_SECRET=YOUR_SUPABASE_JWT_SECRET

# --- Redis (for caching + rate limiting — use Upstash for serverless) ---
REDIS_URL=redis://localhost:6379/0
REDIS_PASSWORD=
CACHE_TTL_SECONDS=300
RATE_LIMIT_PER_MINUTE=100

# --- RabbitMQ (optional — can replace with Supabase Realtime for alerts) ---
RABBITMQ_URL=amqp://guest:guest@localhost:5672/

# --- Webhook Engine ---
WEBHOOK_SIGNING_SECRET=CHANGE_ME_WEBHOOK_HMAC_SECRET
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_RETRIES=5
WEBHOOK_RETRY_DELAYS=1,5,30,120,600

# --- Alert thresholds ---
ALERT_LOW_STOCK_THRESHOLD_PCT=0.20
ALERT_CRITICAL_STOCK_THRESHOLD_PCT=0.05
ALERT_DEPLETION_WARNING_DAYS=7

# --- Frontend (Vite) ---
VITE_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR_ANON_PUBLIC_KEY
VITE_API_BASE_URL=http://localhost:8000/api/v1
